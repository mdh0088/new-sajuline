# 사주라인 통합 개발 환경 변수 설정
# 이 파일을 .env로 복사하여 사용하세요

# ===========================================
# 전역 설정
# ===========================================
COMPOSE_PROJECT_NAME=sajuline
ENVIRONMENT=development

# ===========================================
# 프론트엔드 설정 (Nuxt.js)
# ===========================================
FRONTEND_PORT=3000
NODE_ENV=development
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ===========================================
# 백엔드 설정 (FastAPI)
# ===========================================
BACKEND_PORT=8000
DEBUG=true
SECRET_KEY=development-secret-key-change-in-production-32chars
LOG_LEVEL=INFO

# CORS 설정
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 레이트 리미터 설정
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# ===========================================
# 데이터베이스 설정 (PostgreSQL)
# ===========================================
POSTGRES_DB=sajuline
POSTGRES_USER=sajuline
POSTGRES_PASSWORD=sajuline123
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sajuline:sajuline123@postgres:5432/sajuline

# ===========================================
# 캐시 설정 (Redis)
# ===========================================
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# ===========================================
# MSSQL ARS (개발용)
# ===========================================
# 도커 컴포즈의 mssql-ars 서비스가 사용하는 SA 비밀번호
# 실제 사용 시 .env 파일에 안전한 값으로 설정하세요
MSSQL_SA_PASSWORD=Str0ng!Passw0rd

# ===========================================
# AI 서비스 설정
# ===========================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
AI_CACHE_TTL=300

# ===========================================
# 파일 업로드 설정 (S3)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=sajuline-files
# CDN URL (이미 구축됨)
CDN_BASE_URL=https://cdn.sajuline.com/dev-upload/cs

# ===========================================
# 개발 도구 설정
# ===========================================

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@sajuline.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Redis Commander
REDIS_COMMANDER_PORT=8081
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123

# ===========================================
# 모니터링 설정 (프로필 옵션)
# ===========================================

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ===========================================
# 프로덕션 설정 (프로필 옵션)
# ===========================================

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# SSL 인증서 경로
SSL_CERT_PATH=./ssl/cert.pem
SSL_KEY_PATH=./ssl/key.pem

# ===========================================
# 네트워크 설정
# ===========================================
NETWORK_SUBNET=172.20.0.0/16
NETWORK_GATEWAY=172.20.0.1 