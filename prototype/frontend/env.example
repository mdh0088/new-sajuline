# ===================================
# Nuxt.js Frontend Environment Variables Template
# ===================================

# Environment Configuration
NUXT_PUBLIC_ENVIRONMENT=development

# API Configuration
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Social Login (Public Keys Only)
NUXT_PUBLIC_KAKAO_CLIENT_ID=52c3b7fd29640d0794c65676ccea1e8a
NUXT_PUBLIC_NAVER_CLIENT_ID=UbulJR6fs_MM2G5QGMFC
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# Monitoring & Analytics
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NUXT_PUBLIC_ENABLE_AI_CHAT=true
NUXT_PUBLIC_ENABLE_VOICE_CALL=false
NUXT_PUBLIC_ENABLE_DEBUG_MODE=false
NUXT_PUBLIC_ENABLE_SOCIAL_LOGIN=true
NUXT_PUBLIC_ENABLE_PAYMENT=true

# Private Server Keys (Server-side only)
API_SECRET=your-api-secret-key

# SEO & Meta
NUXT_PUBLIC_SITE_NAME=사주라인
NUXT_PUBLIC_SITE_DESCRIPTION=전통과 혁신이 만나는 온라인 사주 상담
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# CDN & Static Assets
NUXT_PUBLIC_CDN_URL=
NUXT_PUBLIC_ASSET_PREFIX=

# Timeout Settings
NUXT_PUBLIC_API_TIMEOUT=30000
NUXT_PUBLIC_WS_TIMEOUT=5000

# Theme Settings
NUXT_PUBLIC_DEFAULT_THEME=light
NUXT_PUBLIC_THEME_PERSISTENCE=true

# Development Settings
NUXT_PUBLIC_MOCK_API=false
NUXT_PUBLIC_HOT_RELOAD=true