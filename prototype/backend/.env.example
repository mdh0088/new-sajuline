# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security Settings (⚠️ 프로덕션에서는 반드시 변경)
# openssl rand -hex 32 명령어로 생성한 값을 사용하세요
SECRET_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (MariaDB)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dbname?charset=utf8mb4
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_DB=0
REDIS_PASSWORD=

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
AI_CACHE_TTL=300

# AWS S3 Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=

# Social Login Configuration
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Payment Gateway Configuration
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=

# Monitoring Configuration
SENTRY_DSN=https://64984682abf57e246bd730a411efe33f@o4509881056296960.ingest.us.sentry.io/4509881057345536

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_WEBHOOKS=false

# Docker Environment
DOCKER_ENV=false

# Admin Settings
# 관리자 비밀번호는 반드시 환경변수로 설정하세요
# 프로덕션 환경에서는 openssl rand -base64 32 명령으로 강력한 비밀번호 생성
ADMIN_EMAIL=MUST_BE_CHANGED_VIA_ENV_VAR@example.com
ADMIN_PASSWORD=MUST_BE_CHANGED_AND_SET_VIA_ENV_VAR

# Data Encryption (Optional)
DATA_ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=