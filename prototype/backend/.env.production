# Application Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security Settings (⚠️ 프로덕션에서는 반드시 변경)
SECRET_KEY=MUST_SET_FROM_ENV_VAR_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Settings
CORS_ORIGINS=https://sajuline.com
FRONTEND_URL=https://sajuline.com
TRUSTED_HOSTS=localhost,backend,frontend,sajuline.com,127.0.0.1,0.0.0.0

# Database Configuration (MariaDB - 프로덕션 환경에서 실제 정보로 변경)
DATABASE_URL=MUST_SET_FROM_ENV_VAR_IN_PRODUCTION
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_DB=0
REDIS_PASSWORD=

# AI Service Configuration (⚠️ 실제 API 키로 변경)
OPENAI_API_KEY=MUST_SET_FROM_ENV_VAR_IN_PRODUCTION
OPENAI_MODEL=gpt-4
AI_CACHE_TTL=300

# AWS S3 Configuration (⚠️ 실제 AWS 정보로 변경)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-s3-bucket-name

# Social Login Configuration
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Payment Gateway Configuration
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=

# Monitoring Configuration
SENTRY_DSN=

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_WEBHOOKS=false

# Docker Environment
DOCKER_ENV=true

# Admin Settings (⚠️ 프로덕션에서는 반드시 변경)
ADMIN_EMAIL=MUST_SET_FROM_ENV_VAR
ADMIN_PASSWORD=MUST_SET_FROM_ENV_VAR

# Logging overrides (added)
LOG_JSON=true
LOG_TO_STDOUT=true
LOG_TO_FILE=true
LOG_DIR=/var/log/app
LOG_FILE_NAME=app.log
SERVICE_NAME=sajuline-api
SERVICE_VERSION=1.0.0