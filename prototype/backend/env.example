# ===================================
# FastAPI Backend Environment Variables Template
# ===================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security Settings
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://frontend:3000,https://sajuline.com,https://dev.sajuline.com
# NOTE: OAuth redirect_uri는 반드시 아래 FRONTEND_URL 기반으로 생성됩니다.
# 운영/스테이징/로컬 환경별 실제 접근 도메인과 정확히 일치시키세요(스킴/도메인/포트/경로).
# 예) https://dev.sajuline.com  →  https://dev.sajuline.com/auth/social/naver/callback
FRONTEND_URL=https://dev.sajuline.com
TRUSTED_HOSTS=localhost,backend,frontend,sajuline.com,127.0.0.1,0.0.0.0

# Database Configuration (MariaDB)
DATABASE_URL=mysql+aiomysql://sajuline:sajuline123@mariadb:3306/sajuline?charset=utf8mb4
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# MSSQL (ARS) Configuration
# Set these to enable ARS sync (MSSQL). If not set correctly, ARS-related operations will fail.
MSSQL_HOST=mssql-ars
MSSQL_PORT=1433
MSSQL_DB=ars
MSSQL_USER=sa
MSSQL_PASSWORD=CHANGE_THIS_PASSWORD
MSSQL_DEV_DRIVER=pymssql
MSSQL_PROD_DRIVER=pymssql

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_DB=0
REDIS_PASSWORD=

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
AI_CACHE_TTL=300

# File Upload Settings
UPLOAD_MAX_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,txt

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=

# Social Login Configuration (각 공급자 콘솔에 등록된 앱 정보와 동일해야 합니다)
# Callback URL (NAVER): ${FRONTEND_URL}/auth/social/naver/callback
# Callback URL (KAKAO): ${FRONTEND_URL}/auth/social/kakao/callback
KAKAO_CLIENT_ID=__REPLACE_WITH_KAKAO_REST_API_KEY__
NAVER_CLIENT_ID=__REPLACE_WITH_NAVER_CLIENT_ID__
NAVER_CLIENT_SECRET=__REPLACE_WITH_NAVER_CLIENT_SECRET__

# Payment Gateway Configuration
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=

# Monitoring Configuration
SENTRY_DSN=https://64984682abf57e246bd730a411efe33f@o4509881056296960.ingest.us.sentry.io/4509881057345536

# Rate Limiter Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# Docker Environment Flag
DOCKER_ENV=false

# External Service URLs
EMAIL_SERVICE_URL=
SMS_SERVICE_URL=
WEBHOOK_BASE_URL=

# Encryption Settings
ENCRYPTION_KEY=
DATA_ENCRYPTION_ENABLED=false

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_WEBHOOKS=false

# Admin Settings
ADMIN_EMAIL=admin@sajuline.com
ADMIN_PASSWORD=admin123