# 관리자 백엔드 환경 변수 설정

# 기본 설정
APP_NAME=Sajuline Admin API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
PORT=8001

# 보안
SECRET_KEY=admin-secret-key-for-local-development-only-change-in-prod
ADMIN_SECRET_KEY=admin-specific-secret-key
JWT_SECRET_KEY=admin-jwt-secret-for-local-dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 설정
CORS_ORIGINS=http://localhost:3001,http://localhost:8001,http://127.0.0.1:3001,http://127.0.0.1:8001

# 데이터베이스 설정 (MariaDB) - Docker 컨테이너 연결
DATABASE_URL=mysql+aiomysql://sajuline:sajuline123@34.64.202.147:3306/sajuline?charset=utf8mb4
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# 외부 데이터베이스 (MSSQL 2005 - 읽기 전용) - Docker 컨테이너 연결
MSSQL_SERVER=34.64.202.147
MSSQL_PORT=1433
MSSQL_DATABASE=ars
MSSQL_USERNAME=sa
MSSQL_PASSWORD=Str0ng!Passw0rd
MSSQL_DRIVER=pymssql
MSSQL_TIMEOUT=30

# 로깅 설정
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=logs/admin.log

# Sentry (에러 추적)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# AWS S3 (파일 저장)
AWS_ACCESS_KEY_ID=AKIAQEIP3DTTO5WQ2MHF
AWS_SECRET_ACCESS_KEY=e+sMnv7kA/W/D6om0H/iMkf3uNLKzfA+zbmK8Ixk
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=static.sajuline.com
