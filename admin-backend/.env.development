# 관리자 권한 설정
ADMIN_ROLES=super_admin,admin,manager,support
SUPER_ADMIN_EMAIL=super@sajuline.com

# 이중 인증 설정
ENABLE_2FA=false
OTP_ISSUER=Sajuline Admin

# 감사 로그 설정
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=90

# 백업 설정
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30

# 세션 설정
SESSION_TIMEOUT_MINUTES=30
SESSION_EXTEND_ON_ACTIVITY=true

# API 문서
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# 외부 서비스 API URL
MAIN_BACKEND_URL=http://localhost:8000
MAIN_FRONTEND_URL=http://localhost:3000

# 통계 및 분석
ENABLE_ANALYTICS=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=60

# 알림 설정
SLACK_WEBHOOK_URL=
EMAIL_NOTIFICATION_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=admin@sajuline.com

# 기타 설정
TIMEZONE=Asia/Seoul
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.xlsx,.csv
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

