# Admin Backend Environment Configuration
# Copy this file to .env.development or .env.production and fill in the values

# Basic Settings
APP_NAME=Sajuline Admin API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
PORT=8001

# Security
SECRET_KEY=your-secret-key-here
ADMIN_SECRET_KEY=your-admin-secret-key
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:8001

# Database (MariaDB)
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dbname?charset=utf8mb4
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# External Database (MSSQL - Read Only)
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=ars
MSSQL_USERNAME=your-user
MSSQL_PASSWORD=your-password
MSSQL_DRIVER=pymssql
MSSQL_TIMEOUT=30

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=logs/admin.log

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-bucket-name
S3_DIRECTORY=dev-upload

# Admin Roles
ADMIN_ROLES=super_admin,admin,manager,support
SUPER_ADMIN_EMAIL=super@example.com

# 2FA
ENABLE_2FA=false
OTP_ISSUER=Sajuline Admin

# Audit Log
ENABLE_AUDIT_LOG=true
AUDIT_LOG_RETENTION_DAYS=90

# Backup
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30

# Session
SESSION_TIMEOUT_MINUTES=30
SESSION_EXTEND_ON_ACTIVITY=true

# API Docs
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# External Services
MAIN_BACKEND_URL=http://localhost:8000
MAIN_FRONTEND_URL=http://localhost:3000

# Analytics
ENABLE_ANALYTICS=true
ANALYTICS_BATCH_SIZE=100
ANALYTICS_FLUSH_INTERVAL=60

# Notifications
SLACK_WEBHOOK_URL=
EMAIL_NOTIFICATION_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=admin@example.com

# Other Settings
TIMEZONE=Asia/Seoul
MAX_UPLOAD_SIZE=10485760
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.xlsx,.csv
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Payment
PAYMENT_GATEWAY_URL=https://testpgapi.payletter.com/v1.0/payments/request
PAYMENT_GATEWAY_KEY=your-payment-key
PAYMENT_CLIENT_ID=your-client-id
