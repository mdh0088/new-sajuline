# Backend Environment Configuration
# Copy this file to .env.development or .env.production and fill in the values

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security Settings (CHANGE IN PRODUCTION!)
SECRET_KEY=your-strong-random-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1
ALGORITHM=HS256

# CORS Settings
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# MariaDB Configuration
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_DB=sajuline
MARIADB_USER=sajuline
MARIADB_PASSWORD=your-db-password
MARIADB_CHARSET=utf8mb4
MARIADB_ECHO=false
MARIADB_POOL_SIZE=10
MARIADB_MAX_OVERFLOW=20

# MSSQL Configuration (ARS)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=ars
MSSQL_USER=your-user
MSSQL_PASSWORD=your-password
MSSQL_DEV_DRIVER=pymssql
MSSQL_PROD_DRIVER=pymssql
MSSQL_POOL_SIZE=10
MSSQL_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_DB=0
REDIS_PASSWORD=

# AI Service Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
AI_CACHE_TTL=300

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-bucket-name
S3_DIRECTORY=upload

# Social Login - Kakao
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_AUTH_URL=https://kauth.kakao.com/oauth/authorize
KAKAO_TOKEN_URL=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URL=https://kapi.kakao.com/v2/user/me
KAKAO_REDIRECT_URI=http://localhost:3000/auth/social/kakao/callback

# Social Login - Naver
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_AUTH_URL=https://nid.naver.com/oauth2.0/authorize
NAVER_TOKEN_URL=https://nid.naver.com/oauth2.0/token
NAVER_USER_INFO_URL=https://openapi.naver.com/v1/nid/me
NAVER_REDIRECT_URI=http://localhost:3000/auth/social/naver/callback

# Monitoring
SENTRY_DSN=

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_WEBHOOKS=false

# Docker
DOCKER_ENV=true

# KCP Phone Verification
KCP_BASE_DIR=/app/kcp_binaries
KCP_TEST_MODE=true
API_BASE_URL=http://localhost:8000
KCP_TEST_SITE_CD=your-site-code
KCP_TEST_ENC_KEY=your-enc-key
KCP_WEB_SITEID=your-web-site-id
KCP_PROD_SITE_CD=
KCP_PROD_ENC_KEY=

# Admin Settings
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Logging
LOG_JSON=true
LOG_TO_STDOUT=true
LOG_TO_FILE=false
SERVICE_NAME=sajuline-api
SERVICE_VERSION=dev

# Payment
PAYMENT_GATEWAY_URL=https://testpgapi.payletter.com/v1.0/payments/request
PAYMENT_GATEWAY_KEY=your-payment-gateway-key
PAYMENT_CLIENT_ID=your-client-id
PAYMENT_NAVER_KEY=your-naver-payment-key
PAYMENT_NAVER_ID=your-naver-id
PAYMENT_CANCEL_URL=https://localhost:3000/api/v1/payment/point_cancel
PAYMENT_RETURN_URL=https://localhost:3000/api/v1/payment/point_return
PAYMENT_CALLBACK_URL=https://localhost:3000/api/v1/payment/point_callback
PAYMENT_VIRTUAL_CALLBACK_URL=https://localhost:3000/api/v1/payment/virtual_callback

# Email
GOOGLE_EMAIL_ID=your-email@gmail.com
GOOGLE_EMAIL_PASSWORD=your-app-password

# Kakao Alarm
KAKAO_ALARM_URL=https://jupiter.lunasoft.co.kr/api/AlimTalk/message/send
KAKAO_ALARM_KEY=your-kakao-alarm-key
KAKAO_ALARM_SITE_ID=your-site-id
