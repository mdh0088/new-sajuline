# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security Settings (⚠️ 프로덕션에서는 반드시 변경)
# 개발용 시크릿 키 - 프로덕션에서는 강력한 랜덤 값 사용
SECRET_KEY=dev-secret-key-for-local-development-only-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://frontend:3000,https://sajuline.com
FRONTEND_URL=http://localhost:3000
TRUSTED_HOSTS=localhost,backend,frontend,sajuline.com,127.0.0.1,0.0.0.0

# MariaDB Configuration (Primary Database)
# ⚠️ Docker Compose MariaDB 설정과 일치
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DB=sajuline
MARIADB_USER=sajuline
MARIADB_PASSWORD=sajuline123
MARIADB_CHARSET=utf8mb4
MARIADB_ECHO=false
MARIADB_POOL_SIZE=10
MARIADB_MAX_OVERFLOW=20

# MSSQL Configuration (ARS 연동)
MSSQL_HOST=mssql-ars
MSSQL_PORT=1433
MSSQL_DB=ars
MSSQL_USER=sa
MSSQL_PASSWORD=Str0ng!Passw0rd
MSSQL_DEV_DRIVER=pymssql
MSSQL_PROD_DRIVER=pymssql

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_DB=0
REDIS_PASSWORD=

# AI Service Configuration (⚠️ 실제 API 키로 변경)
OPENAI_API_KEY=CHANGE_THIS_USE_ENV_VAR
OPENAI_MODEL=gpt-4
AI_CACHE_TTL=300

# AWS S3 Configuration (⚠️ 실제 AWS 정보로 변경)
